<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only additions. This source set is not part of a release build, so
  nothing here can reach a shipped APK.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          A sign-up form to point the autofill service at.

          Autofill behaviour cannot be tested from inside the app that provides
          it: the whole feature is about what happens in *someone else's* form,
          and the newPassword hint is the signal the generator offer depends
          on. Real sign-up pages in a browser are worse for this, because
          Chrome answers with its own password manager before Zerokosh is
          asked.
        -->
        <activity
            android:name=".debug.SignupFormActivity"
            android:exported="true"
            android:label="Zerokosh autofill test" />
    </application>
</manifest>
