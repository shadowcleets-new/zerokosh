<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- CAMERA is the ONLY dangerous permission (TOTP QR scan, runtime, optional — §0.6/§6.7) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

        <!-- Reader mode only: the app acts as a terminal to read the user's own card.
         Not required, so the app still installs on phones without NFC. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

<application
        android:name=".ZerokoshApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/Theme.Zerokosh"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The unlock the autofill service asks for. Not exported: only the
             PendingIntent handed to the platform ever starts it, and that does
             not need the activity to be open to other apps. excludeFromRecents
             because a sheet that unlocks a password vault has no business
             appearing in the recents list.

             No android:noHistory. It looks right for a sheet that should not
             be returned to, and it silently breaks the whole feature: a
             noHistory activity is destroyed on leaving the foreground before
             its result propagates, so setResult never reached the platform and
             unlocking left the same "Unlock Zerokosh to fill" row sitting
             there. finish() after delivering is what retires this activity. -->
        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.Zerokosh.AutofillSheet"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Credential Manager provider (Android 14+). Alongside the autofill
             service below, not instead of it: an app that signs users in with
             CredentialManager never reaches AutofillService, and autofill is
             still the only path below API 34. Both are separate switches in
             system settings and both may be on.

             BIND_CREDENTIAL_PROVIDER_SERVICE means only the system may bind. -->
        <service
            android:name=".credentials.ZerokoshCredentialProviderService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>

        <!-- Where a picked row becomes a credential. Not exported: only the
             PendingIntent handed to the platform starts it. Same sheet theme as
             the autofill unlock, and for the same reason — it floats over
             somebody else's screen. -->
        <activity
            android:name=".credentials.CredentialEntryActivity"
            android:exported="false"
            android:theme="@style/Theme.Zerokosh.AutofillSheet"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- §6.7 autofill provider. BIND_AUTOFILL_SERVICE means only the system
             may bind to it. Without this entry the service class existed but was
             invisible to Android, so it could never be selected (BV-01). -->
        <service
            android:name=".autofill.ZerokoshAutofillService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>
    </application>
</manifest>
