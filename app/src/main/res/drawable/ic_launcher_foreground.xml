<?xml version="1.0" encoding="utf-8"?>
<!--
  The Zerokosh mark: a kosh — a treasury vessel — with a single deposit slot.

  One path, not two. The slot has to be an actual hole via evenOdd rather than a
  paper-coloured shape laid on top, because this same drawable is the monochrome
  layer: Android tints that flat for themed icons, and an overlay would fill in
  and render the mark as a solid blob.

  Art is authored on a 24-unit grid and scaled 3.2x into the 108dp adaptive
  viewport. Not 4x, which is what the safe-zone width alone suggests: launchers
  mask adaptive icons to a circle of radius 36dp, and the *corners* of a
  rectangular mark are further from the centre than its edges. At 4x the body
  corner sat 43dp out and the vessel's shoulders came back visibly sliced flat
  on a Pixel. 3.2x puts the corner at 34.4dp, inside the circle with margin.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="3.2"
        android:scaleY="3.2"
        android:translateX="15.6"
        android:translateY="15.6">
        <path
            android:fillColor="#FDFAF6"
            android:fillType="evenOdd"
            android:pathData="M4.52,6.78 C4.34,5.57 5.18,4.6 6.4,4.6 L17.6,4.6 C18.82,4.6 19.66,5.57 19.48,6.78 L18.1,16.04 C17.82,17.89 16.08,19.4 14.2,19.4 L9.8,19.4 C7.92,19.4 6.18,17.89 5.9,16.04 L4.52,6.78 Z M8.3,10.95 C8.3,10.2 8.9,9.6 9.65,9.6 L14.35,9.6 C15.1,9.6 15.7,10.2 15.7,10.95 C15.7,11.7 15.1,12.3 14.35,12.3 L9.65,12.3 C8.9,12.3 8.3,11.7 8.3,10.95 Z" />
    </group>
</vector>
