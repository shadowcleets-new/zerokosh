    <!-- S4 Recovery kit -->
    <string name="scr_recovery_title">आपकी रिकवरी कुंजी</string>
    <string name="scr_recovery_body">अगर कभी पासफ़्रेज़ भूल जाएँ, तो अंदर लौटने का सिर्फ़ यही एक रास्ता है। हम इसे रीसेट नहीं कर सकते — कोई नहीं कर सकता।</string>
    <string name="scr_recovery_save_pdf">पीडीएफ़ में सहेजें</string>
    <string name="scr_recovery_confirm_check">मैंने इसे लिख लिया है और सुरक्षित जगह रख दिया है</string>
    <string name="scr_recovery_done">आगे बढ़ें</string>
    <string name="scr_recovery_never_again">इस स्क्रीन के बाद यह कुंजी दोबारा नहीं दिखेगी।</string>
    <string name="scr_recovery_pdf_saved">रिकवरी किट पीडीएफ़ सहेज दी गई</string>
    <string name="scr_recovery_pdf_instructions">इस पन्ने को अपने ज़मीन-जायदाद के कागज़ों या दूसरे ज़रूरी दस्तावेज़ों के साथ रखें। जिसके पास यह कुंजी होगी वह आपकी तिजोरी खोल सकता है — इसे लॉकर की चाबी की तरह सँभालें।</string>
    <string name="scr_recovery_pdf_title">Zerokosh रिकवरी किट</string>

