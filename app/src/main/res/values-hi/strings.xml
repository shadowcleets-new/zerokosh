    <!-- S2 Trust explainer -->
    <string name="scr_trust_card1_title">आपका डेटा इसी फ़ोन में रहता है</string>
    <string name="scr_trust_card1_body">आप जो कुछ सहेजते हैं वह आपके फ़ोन की एक बंद फ़ाइल में रहता है। वह कभी हम तक नहीं आता — हमारे पास उसे रखने की जगह ही नहीं है।</string>
    <string name="scr_trust_card2_title">हमारा कोई सर्वर नहीं — न हैक होने को कुछ, न बेचने को</string>
    <string name="scr_trust_card2_body">न कोई Zerokosh खाता, न क्लाउड, न साइन-अप। इसे सिर्फ़ आप खोल सकते हैं। हम भी नहीं।</string>
    <string name="scr_trust_card3_title">हमेशा मुफ़्त, ओपन सोर्स</string>
    <string name="scr_trust_card3_body">न कोई सदस्यता शुल्क, न विज्ञापन। कोई भी हमारा कोड पढ़कर हमारा हर वादा जाँच सकता है।</string>
    <string name="scr_trust_continue">आगे बढ़ें</string>

