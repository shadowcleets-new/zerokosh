    <!-- S4 Recovery kit -->
    <string name="scr_recovery_title">तुमची रिकव्हरी किल्ली</string>
    <string name="scr_recovery_body">कधी पासफ्रेज विसरलात, तर आत परत येण्याचा हाच एकमेव मार्ग आहे. आम्ही तो रीसेट करू शकत नाही — कोणीच करू शकत नाही.</string>
    <string name="scr_recovery_save_pdf">पीडीएफमध्ये साठवा</string>
    <string name="scr_recovery_confirm_check">मी ते लिहून घेतले आहे आणि सुरक्षित जागी ठेवले आहे</string>
    <string name="scr_recovery_done">पुढे चला</string>
    <string name="scr_recovery_never_again">ही किल्ली एकदाच दिसते. जोपर्यंत तुम्ही तिजोरी उघडू शकता, तोपर्यंत सेटिंगमधून केव्हाही नवी बनवता येते.</string>
    <string name="scr_recovery_pdf_saved">रिकव्हरी किट पीडीएफ साठवली</string>
    <string name="scr_recovery_pdf_instructions">हे पान तुमच्या मालमत्तेच्या कागदपत्रांसोबत किंवा इतर महत्त्वाच्या कागदांसोबत ठेवा. ही किल्ली ज्याच्याकडे असेल तो तुमची तिजोरी उघडू शकतो — तिला लॉकरच्या किल्लीसारखे जपा.</string>
    <string name="scr_recovery_pdf_title">Zerokosh रिकव्हरी किट</string>

