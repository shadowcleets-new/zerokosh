    <string name="scr_create_pin_option">त्याऐवजी 6 अंकी पिन ठेवा</string>
    <string name="scr_create_pin_hint">6 अंकी पिन</string>
    <string name="scr_create_pin_why">पिन चालतो कारण हा फोन त्याला स्वतःच्या सुरक्षा चिपने आणि तुमच्या बोटाने किंवा चेहऱ्याने जपतो.</string>
    <string name="scr_create_pin_unavailable">पिनसाठी फिंगरप्रिंट किंवा फेस अनलॉक असलेला फोन लागतो. कृपया पासफ्रेज निवडा.</string>
    <string name="scr_create_button">बंद करून टाका</string>
