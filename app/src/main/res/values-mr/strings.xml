    <!-- S2 Trust explainer -->
    <string name="scr_trust_card1_title">तुमचा डेटा याच फोनमध्ये राहतो</string>
    <string name="scr_trust_card1_body">तुम्ही जे काही साठवता ते तुमच्या फोनमधल्या एका बंद फाइलमध्ये राहते. ते कधीही आमच्यापर्यंत येत नाही — ते ठेवायला आमच्याकडे जागाच नाही.</string>
    <string name="scr_trust_card2_title">आमचा कोणताही सर्व्हर नाही — ना हॅक व्हायला काही, ना विकायला</string>
    <string name="scr_trust_card2_body">ना Zerokosh खाते, ना क्लाउड, ना साइन-अप. हे फक्त तुम्हीच उघडू शकता. आम्हीही नाही.</string>
    <string name="scr_trust_card3_title">कायम मोफत, ओपन सोर्स</string>
    <string name="scr_trust_card3_body">ना वर्गणी, ना जाहिराती. कोणीही आमचा कोड वाचून आमचे प्रत्येक वचन तपासू शकतो.</string>
    <string name="scr_trust_continue">पुढे चला</string>

    <!-- S3 Create passphrase -->
    <string name="scr_create_title">तुमचा पासफ्रेज तयार करा</string>
    <string name="scr_create_body">हाच एक पासफ्रेज सगळे बंद ठेवतो. काहीतरी लांब निवडा, जे फक्त तुम्हालाच माहीत असेल.</string>
