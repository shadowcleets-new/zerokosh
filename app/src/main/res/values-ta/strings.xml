    <string name="ob_kit_skip">இதை பிறகு செய்கிறேன்</string>
    <string name="ob_kit_skip_note">உங்கள் பெட்டகம் வேலை செய்யும். கிட் சேமிக்கும் வரை Zerokosh நினைவூட்டிக்கொண்டே இருக்கும்.</string>
    <string name="ob_kit_challenge_title">கிட் உண்மையில் உங்களிடம் உள்ளதா என்று பாருங்கள்</string>
    <string name="ob_kit_challenge_body">இப்போது சேமித்த கிட்டிலிருந்து %1$d, %2$d குழுக்களைத் தட்டச்சு செய்யுங்கள்.</string>
    <string name="ob_kit_challenge_locked">முதலில் கிட்டைச் சேமியுங்கள், பிறகு %1$d, %2$d குழுக்களைத் திரும்பத் தட்டச்சு செய்யுங்கள்.</string>
    <string name="ob_kit_challenge_hint">குழு %1$d</string>
    <string name="ob_kit_challenge_wrong">இது மேலே உள்ள சாவியுடன் பொருந்தவில்லை.</string>
    <string name="ob_kit_print">அச்சிடு</string>
    <string name="ob_kit_print_note">அச்சுப்பொறி, அல்லது PDF ஆக சேமி</string>
    <string name="ob_kit_saved_to">%1$s இல் சேமிக்கப்பட்டது</string>
    <string name="ob_kit_sent_to_printer">அச்சுப்பொறிக்கு அனுப்பப்பட்டது</string>
    <string name="ob_kit_save_failed">இது சேமிக்கப்படவில்லை. மீண்டும் முயலுங்கள், அல்லது வேறு இடத்தைத் தேர்வு செய்யுங்கள்.</string>
    <string name="ob_kit_beside_vault_title">இது உங்கள் பெட்டக கோப்பின் அருகிலேயே உள்ளது</string>
    <string name="ob_kit_beside_vault_body">உங்கள் மறையாக்கப்பட்ட பெட்டகத்தை ஒத்திசைக்கும் அதே கோப்புறையில் சாவியைச் சேமித்துள்ளீர்கள். இப்போது அந்தக் கோப்புறை கிடைப்பவருக்கு இரண்டுமே கிடைக்கும். சாவியை வேறு இடத்தில் வையுங்கள் — காகிதம், வேறு கணக்கு, அல்லது ஒரு அலமாரி.</string>
    <string name="hm_kit_banner_title">மீட்பு கிட் எதுவும் சேமிக்கப்படவில்லை</string>
    <string name="hm_kit_banner_body">கடவுச்சொற்றொடரை மறந்தால் மீட்பு கிட் மட்டுமே உள்ளே வரும் வழி. உங்களுக்காக இன்னொன்றை யாராலும் உருவாக்க முடியாது.</string>
    <string name="hm_kit_banner_action">இப்போதே சேமி</string>
    <string name="hm_kit_banner_dismiss">பிறகு நினைவூட்டு</string>
    <string name="vh_no_kit_title">மீட்பு கிட் எதுவும் சேமிக்கப்படவில்லை</string>
    <string name="vh_no_kit_body">இந்தப் பக்கத்தில் மற்ற அனைத்தும் ஒரு உள்நுழைவை பலவீனப்படுத்தும். இது முழு பெட்டகத்தையும் இழக்கச் செய்யும். அமைப்புகள் → புதிய மீட்பு சாவி பெறுங்கள்.</string>
    <string name="st_forgot_passphrase">கடவுச்சொற்றொடரை மறந்துவிட்டீர்களா?</string>
    <string name="st_forgot_passphrase_detail">உங்கள் கைரேகையால் புதியது வையுங்கள்</string>
    <string name="pc_reset_title">புதிய கடவுச்சொற்றொடர் வையுங்கள்</string>
    <string name="pc_reset_body">உங்கள் கைரேகை இந்தப் பெட்டகத்தைத் திறக்க முடியும், எனவே அதுவே புதிய கடவுச்சொற்றொடரையும் வைக்க முடியும் — மீட்பு கிட் தேவையில்லை. உறுதிப்படுத்த மீண்டும் ஒருமுறை கேட்கப்படும்.</string>
    <string name="pc_reset_action">புதியதை வை</string>
    <string name="pc_reset_done">கடவுச்சொற்றொடர் மாறியது. விரைவு திறப்பு மீண்டும் அமைக்கப்பட்டது.</string>
    <string name="pc_reset_failed">இது வேலை செய்யவில்லை. உங்கள் பழைய கடவுச்சொற்றொடரே இன்னும் பயன்பாட்டில் உள்ளது.</string>
    <string name="pc_title">உங்கள் கடவுச்சொற்றொடர் இன்னும் நினைவிருக்கிறதா?</string>
    <string name="pc_body">நீங்கள் கைரேகையால் திறக்கிறீர்கள். கைரேகை எப்போதாவது வேலை செய்யாமல் போனால், இதுவே உங்களை உள்ளே கொண்டுவரும் — எனவே பார்த்துக்கொள்வது நல்லது.</string>
    <string name="pc_confirm">சரிபார்</string>
    <string name="pc_wrong">இது அது இல்லை. அதற்குப் பதிலாக புதியது வைக்கலாம்.</string>
    <string name="pc_forgot">எனக்கு நினைவில்லை</string>
    <string name="pc_later">இப்போது வேண்டாம்</string>
    <string name="pc_correct">இன்னும் சரியாக உள்ளது. எதுவும் செய்யத் தேவையில்லை.</string>
    <string name="rem_kit_title">மீட்பு கிட் எதுவும் சேமிக்கப்படவில்லை</string>
    <string name="rem_kit_body">இப்போது உங்கள் பெட்டகத்தில் உண்மையான தகவல் உள்ளது. மீட்பு கிட் இல்லாமல் கடவுச்சொற்றொடரை மறந்தால் யாராலும் உங்களை மீண்டும் உள்ளே கொண்டுவர முடியாது — எங்களாலும் முடியாது.</string>
    <string name="af_generate_title">வலுவான கடவுச்சொல் பயன்படுத்து</string>
