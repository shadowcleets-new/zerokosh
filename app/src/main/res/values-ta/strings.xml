    <string name="ob_kit_qr_note">ஆஃப்லைன் கேலரிக்கு</string>
    <string name="ob_kit_offline_title">அதை இணையத்திலிருந்து விலக்கி வையுங்கள்</string>
    <string name="ob_kit_offline_body">Gmail வேண்டாம், WhatsApp வேண்டாம், ஸ்கிரீன்ஷாட் வேண்டாம். பெட்டகம், வங்கி லாக்கர், அல்லது எஃகுத் தகடு.</string>
    <string name="ob_kit_confirm_emph">"அதை ஆஃப்லைனில் வைத்துவிட்டேன். "</string>
    <string name="ob_kit_confirm_body">யாராலும் — Zerokosh-ஆலும் — அதை எனக்காக மீட்க முடியாது.</string>
    <string name="ob_kit_card_label">ZEROKOSH மீட்பு</string>
    <string name="ob_kit_qr_cd">மீட்புச் சாவியின் QR குறியீடு</string>
    <string name="ob_kit_card_note">ஸ்கேன் செய்யுங்கள் அல்லது தட்டச்சு செய்யுங்கள். மறுநிறுவல், ஃபேக்டரி ரீசெட், ஃபோன் தொலைந்த பிறகும் வேலை செய்யும்.</string>
    <string name="ob_quick_head_lead">"ஒரு தொடுதலில் திறக்கும். "</string>
    <string name="ob_quick_head_emph">கிளவுட் இல்லாமல்.</string>
    <string name="ob_quick_subhead">உள்ளே திரும்ப வர விரைவான வழியைத் தேர்ந்தெடுங்கள். பெட்டகத்தைக் காப்பது கடவுச்சொற்றொடர்தான்; இது இந்த ஃபோனில் மட்டும் சாவியைத் திறக்கிறது.</string>
    <string name="ob_quick_opening">உங்கள் பெட்டகம் திறக்கிறது…</string>
    <string name="ob_quick_enable">விரைவு அன்லாக்-ஐ இயக்கு</string>
    <string name="ob_quick_continue_pass">கடவுச்சொற்றொடருடன் தொடரவும்</string>
    <string name="ob_quick_refused">விரைவு அன்லாக் அமையவில்லை. மீண்டும் முயலுங்கள், அல்லது கடவுச்சொற்றொடருடன் மட்டும் தொடருங்கள்.</string>
    <string name="ob_quick_skip">இப்போது வேண்டாம் — நான் கடவுச்சொற்றொடரைத் தட்டச்சு செய்கிறேன்</string>
    <string name="ob_quick_fingerprint">கைரேகை</string>
    <string name="ob_quick_fingerprint_body">வேகமான, ஹார்ட்வேர் பாதுகாப்புள்ள அன்லாக்.</string>
    <string name="ob_quick_no_sensor">இந்த ஃபோனில் ஹார்ட்வேர் சென்சார் இல்லை.</string>
    <string name="ob_quick_pass_only">கடவுச்சொற்றொடர் மட்டும்</string>
    <string name="ob_quick_pass_only_body">ஒவ்வொரு முறையும் தட்டச்சு செய்யுங்கள். மிகவும் பாதுகாப்பானது.</string>
    <string name="ob_quick_hw_title">ஹார்ட்வேர் பாதுகாப்பு</string>
    <string name="ob_quick_hw_body">Android Keystore / StrongBox. எந்த பயோமெட்ரிக் தகவலும் Zerokosh வரை வருவதே இல்லை.</string>
    <string name="ob_quick_touch_title">சென்சாரைத் தொடுங்கள்</string>
    <string name="ob_quick_touch_body">உங்கள் கைரேகை ஃபோனின் பாதுகாப்பு சிப்புக்குள் இருக்கும். அது இந்த ஃபோனை விட்டு வெளியே வருவதே இல்லை.</string>

