<resources>
    <string name="app_name">Zerokosh</string>

    <!-- S1 Language picker -->
    <string name="scr_language_title">Choose your language</string>
    <string name="scr_language_subtitle">अपनी भाषा चुनें</string>
    <string name="scr_language_continue">Continue</string>

    <!-- S2 Trust explainer -->
    <string name="scr_trust_card1_title">Your data stays on this device</string>
    <string name="scr_trust_card1_body">Everything you save lives in one locked file on your phone. It never goes to us — we have nowhere to put it.</string>
    <string name="scr_trust_card2_title">We have no servers — nothing to hack, nothing to sell</string>
    <string name="scr_trust_card2_body">There is no Zerokosh account, no cloud, no sign-up. Only you can open this. Not even we can.</string>
    <string name="scr_trust_card3_title">Free forever, open source</string>
    <string name="scr_trust_card3_body">No subscription, no ads. Anyone can read our code and check every promise we make.</string>
    <string name="scr_trust_continue">Continue</string>

    <!-- S3 Create passphrase -->
    <string name="scr_create_title">Create your passphrase</string>
    <string name="scr_create_body">This one passphrase locks everything. Choose something long that only you would know.</string>
    <string name="scr_create_hint">Passphrase (at least 10 characters)</string>
    <string name="scr_create_confirm_hint">Type it again</string>
    <string name="scr_create_mismatch">The two entries don\'t match</string>
    <string name="scr_create_too_short">Use at least 10 characters — longer is stronger</string>
    <string name="scr_create_strength_weak">Weak</string>
    <string name="scr_create_strength_fair">Fair</string>
    <string name="scr_create_strength_good">Good</string>
    <string name="scr_create_strength_strong">Strong</string>
    <string name="scr_create_pin_option">Use a 6-digit PIN instead</string>
    <string name="scr_create_pin_hint">6-digit PIN</string>
    <string name="scr_create_pin_why">A PIN is allowed because this phone protects it with its own security chip and your fingerprint or face.</string>
    <string name="scr_create_pin_unavailable">A PIN needs a phone with fingerprint or face unlock. Please use a passphrase.</string>
    <string name="scr_create_button">Lock it in</string>
    <string name="scr_create_working">Preparing your vault…</string>

    <!-- S4 Recovery kit -->
    <string name="scr_recovery_title">Your Recovery Key</string>
    <string name="scr_recovery_body">If you ever forget your passphrase, this key is the ONLY way back in. We cannot reset it for you — nobody can.</string>
    <string name="scr_recovery_save_pdf">Save as PDF</string>
    <string name="scr_recovery_confirm_check">I have written it down and kept it somewhere safe</string>
    <string name="scr_recovery_done">Continue</string>
    <string name="scr_recovery_never_again">You will not see this key again after this screen.</string>
    <string name="scr_recovery_pdf_saved">Recovery Kit PDF saved</string>
    <string name="scr_recovery_pdf_instructions">Keep this page with your property papers or other important documents. Anyone with this key can open your vault — treat it like a key to your locker.</string>
    <string name="scr_recovery_pdf_title">Zerokosh Recovery Kit</string>

