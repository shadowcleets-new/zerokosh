    <!-- §10.5 rotating safety tips -->
    <string name="msg_safety_tip_1">Banks NEVER ask for your OTP. Anyone who does is a fraudster.</string>
    <string name="msg_safety_tip_2">No bank official will ever ask you to install a screen-sharing app.</string>
    <string name="msg_safety_tip_3">Your UPI PIN is only for the UPI app keypad — never tell it to anyone on a call.</string>
    <string name="msg_safety_tip_4">KYC never expires in a day. “KYC expiring today” messages are scams.</string>
    <string name="msg_safety_tip_5">To RECEIVE money you never need to enter your PIN or scan a QR code.</string>
    <string name="msg_safety_tip_6">Electricity bill disconnection SMS with a personal number? It\'s a scam.</string>

