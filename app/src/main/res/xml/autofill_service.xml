<?xml version="1.0" encoding="utf-8"?>
<!-- §6.7: declares the settings activity the system offers from the autofill
     provider picker. Without a <service> entry in the manifest referencing this
     file, the provider is invisible to Android and can never be selected (BV-01). -->
<autofill-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="org.zerokosh.app.MainActivity" />
