<?xml version="1.0" encoding="utf-8"?>
<!--
  What Zerokosh tells the system it can supply.

  Passwords only for now. Passkeys are the other half of Credential Manager
  and are deliberately absent: supporting them means real WebAuthn — ES256
  keys, COSE, CBOR authenticator data, signature counters — and a new record
  type in the vault, which changes the file format and everything that merges
  it. That belongs in its own change with its own review, not smuggled in
  behind a capability line.
-->
<credential-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsSubtitle="@string/scr_trust_card1_title">
    <capabilities>
        <capability name="android.credentials.TYPE_PASSWORD_CREDENTIAL" />
    </capabilities>
</credential-provider>
