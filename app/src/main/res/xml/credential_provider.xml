<?xml version="1.0" encoding="utf-8"?>
<!--
  What Zerokosh tells the system it can supply.

  Passkeys sit beside passwords rather than replacing them. The byte-level
  WebAuthn work lives in core/passkey and is covered by tests against the
  specification, because a passkey that is subtly wrong locks someone out of
  an account that has no password to fall back on.
-->
<credential-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsSubtitle="@string/scr_trust_card1_title">
    <capabilities>
        <capability name="android.credentials.TYPE_PASSWORD_CREDENTIAL" />
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
